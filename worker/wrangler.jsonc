// Cloudflare Worker 配置
// 部署前请将 database_id / kv id 替换为 `wrangler d1 create` / `wrangler kv namespace create` 输出的真实 ID。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-saver",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    // 域名 junwind.site 需托管在同一 Cloudflare 账号下，deploy 时自动创建自定义域
    { "pattern": "link-saver.junwind.site", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link-saver-db",
      "database_id": "d53c6c50-53e0-44bd-a49f-3786527dba6a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c9a2e5f1d5b1423c91f8a3a05e24e84e"
    }
  ],
  "r2_buckets": [
    // 转存图片的对象存储（免费档 10GB）；R2 不可用时自动回退 KV
    {
      "binding": "MEDIA",
      "bucket_name": "link-saver-media"
    }
  ],
  "vars": {
    "WEB_ORIGIN": "https://link-saver.junwind.site",
    "MAIL_FROM": "Link Saver <noreply@junwind.site>"
  },
  "observability": {
    "enabled": true
  }
}
